<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView requerido por la pauta -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:ignore="Typos"> <!-- Ignora los falsos errores ortográficos -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Mensaje de bienvenida -->
        <TextView
            android:id="@+id/tvBienvenida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bienvenido"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="16dp"/>

        <!-- CardView requerido por la pauta -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ImageView requerido con contentDescription -->
                <ImageView
                    android:id="@+id/ivIconoTarea"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_edit"
                    android:contentDescription="@string/descripcion_imagen" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/categoria_tarea" />

                <!-- Spinner requerido -->
                <Spinner
                    android:id="@+id/spCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"/>

                <!-- TableLayout requerido -->
                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="1">

                    <TableRow>
                        <TextView
                            android:padding="8dp"
                            android:text="@string/urgente" />
                        <!-- CheckBox requerido -->
                        <CheckBox
                            android:id="@+id/cbUrgente"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/si_es_prioridad"/>
                    </TableRow>

                    <TableRow>
                        <TextView
                            android:text="@string/estado"
                            android:padding="8dp"/>
                        <RadioGroup
                            android:id="@+id/rgEstado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <!-- RadioButton requerido -->
                            <RadioButton
                                android:id="@+id/rbPendiente"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pendiente"
                                android:checked="true"/>
                            <RadioButton
                                android:id="@+id/rbEnProceso"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/en_proceso"/>
                        </RadioGroup>
                    </TableRow>
                </TableLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dificultad_tarea"
                    android:layout_marginTop="16dp"/>

                <!-- RatingBar requerido -->
                <RatingBar
                    android:id="@+id/rbDificultad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:stepSize="1"
                    android:layout_gravity="center"/>

                <Button
                    android:id="@+id/btnGuardarTarea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guardar_tarea"
                    android:layout_marginTop="16dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/progreso_tareas"
            android:textStyle="bold"/>

        <!-- ProgressBar requerido -->
        <ProgressBar
            android:id="@+id/pbProgreso"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mis_tareas_lista"
            android:textStyle="bold"/>

        <!-- RecyclerView requerido -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTareas"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>