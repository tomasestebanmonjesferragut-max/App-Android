<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView requerido por la pauta -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Mensaje de bienvenida -->
        <TextView
            android:id="@+id/tvBienvenida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bienvenido"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="16dp"/>

        <!-- CardView requerido por la pauta -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ImageView requerido -->
                <ImageView
                    android:id="@+id/ivIconoTarea"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_edit" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Categoría de la tarea:"
                    android:layout_marginTop="8dp"/>

                <!-- Spinner requerido -->
                <Spinner
                    android:id="@+id/spCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"/>

                <!-- TableLayout requerido -->
                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="1">

                    <TableRow>
                        <TextView android:text="Urgente:" android:padding="8dp"/>
                        <!-- CheckBox requerido -->
                        <CheckBox
                            android:id="@+id/cbUrgente"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sí, es prioridad"/>
                    </TableRow>

                    <TableRow>
                        <TextView android:text="Estado:" android:padding="8dp"/>
                        <RadioGroup
                            android:id="@+id/rgEstado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <!-- RadioButton requerido -->
                            <RadioButton
                                android:id="@+id/rbPendiente"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pendiente"
                                android:checked="true"/>
                            <RadioButton
                                android:id="@+id/rbEnProceso"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="En Proceso"/>
                        </RadioGroup>
                    </TableRow>
                </TableLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dificultad de la tarea:"
                    android:layout_marginTop="16dp"/>

                <!-- RatingBar requerido -->
                <RatingBar
                    android:id="@+id/rbDificultad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:stepSize="1"
                    android:layout_gravity="center"/>

                <Button
                    android:id="@+id/btnGuardarTarea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Guardar Tarea"
                    android:layout_marginTop="16dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Progreso de tareas:"
            android:textStyle="bold"/>

        <!-- ProgressBar requerido -->
        <ProgressBar
            android:id="@+id/pbProgreso"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mis Tareas (Lista):"
            android:textStyle="bold"/>

        <!-- RecyclerView requerido -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTareas"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>